#pragma kernel Clear
#pragma kernel Scan
#pragma target 6.0
#pragma use_dxc
StructuredBuffer<uint4> _Samples, _Queries;
StructuredBuffer<uint> _Active;
RWStructuredBuffer<uint4> _Results;
uint _Count, _QueryCount;
uint Mix(uint v) { v ^= v >> 16u; v *= 0x7feb352du; v ^= v >> 15u; v *= 0x846ca68bu; return v ^ (v >> 16u); }
[numthreads(256,1,1)]
void Clear(uint3 tid : SV_DispatchThreadID) { if (tid.x < _QueryCount) _Results[tid.x] = 0; }
[numthreads(256,1,1)]
void Scan(uint3 gid : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint id = gid.x * 256u + lane;
    uint4 q = _Queries[gid.y];
    uint r = min(q.w, 65535u);
    uint3 low = q.xyz - min(q.xyz, r.xxx), high = min(q.xyz + r, 65535u);
    bool valid = false;
    uint4 s = 0, value = 0;
    if (id < _Count) { valid = _Active[id] == 1u; if (valid) s = _Samples[id]; }
    if (valid && all(s.xyz >= low) && all(s.xyz <= high))
    {
        uint h = Mix(Mix(Mix(Mix(Mix(id ^ 0x85ebca6bu) ^ s.x) ^ s.y) ^ s.z) ^ s.w);
        value = uint4(1, h, h, Mix(h ^ id ^ 0x27d4eb2fu));
    }
    value = uint4(WaveActiveSum(value.x), WaveActiveBitXor(value.y), WaveActiveSum(value.z), WaveActiveSum(value.w));
    if (WaveIsFirstLane() && value.x != 0u)
    {
        InterlockedAdd(_Results[gid.y].x, value.x); InterlockedXor(_Results[gid.y].y, value.y);
        InterlockedAdd(_Results[gid.y].z, value.z); InterlockedAdd(_Results[gid.y].w, value.w);
    }
}
