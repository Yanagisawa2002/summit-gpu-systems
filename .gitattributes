* text=auto
*.cs text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.md text eol=lf
*.asmdef text eol=lf
*.asset text eol=lf whitespace=-trailing-space
*.meta text eol=lf whitespace=-trailing-space
*.unity text eol=lf whitespace=-trailing-space
*.yaml text eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.dll binary
*.png binary
# Imported source bytes are bound by the HLSL exporter manifest, including line endings.
Integrations/HlslKernelPipeline/Artifact~/** -text
Integrations/HlslKernelPipeline/Artifact~/consumer-manifest.json text eol=lf
# Preserve upstream notice whitespace along with its exact reviewed byte hash.
PublicBenchmarks/External/Notices/*.txt -text whitespace=-trailing-space
