            "        public GraphicsBuffer Diagnostics { get; }",
            "        public long ResidentBytes => (long)Capacity * 12 +",
            "            (2L * GpuSensorPipeline.FixedBinCount + 3) * 4 + binner.ScratchBytes;"
          ]
